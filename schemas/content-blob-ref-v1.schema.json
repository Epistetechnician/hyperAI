{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentBlobRefV1",
  "type": "object",
  "properties": {
    "byte_length": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "classification": {
      "$ref": "#/$defs/EvidenceClassification"
    },
    "digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "digest_algorithm": {
      "type": "string"
    },
    "media_type": {
      "type": "string"
    },
    "storage_locator": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "digest_algorithm",
    "digest",
    "byte_length",
    "media_type",
    "classification",
    "storage_locator"
  ],
  "$defs": {
    "EvidenceClassification": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "EMBARGOED",
        "OPERATOR_ONLY",
        "SECRET_REFERENCE_ONLY"
      ]
    },
    "Sha256Digest": {
      "description": "A SHA-256 digest serialized as 64 lowercase hexadecimal characters.",
      "type": "string"
    }
  }
}
