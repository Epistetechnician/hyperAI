{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justai.org/schemas/justai.v1/envelope.schema.json",
  "title": "JustAI record envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema", "record_id", "state_slice", "status", "claim_ceiling",
    "created_at", "publisher_id", "source_digests", "content_digest", "signature_refs"
  ],
  "properties": {
    "schema": {"type": "string", "pattern": "^justai\\.[a-z0-9.-]+\\.v[0-9]+$"},
    "record_id": {"type": "string", "minLength": 1},
    "state_slice": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "publisher_id": {"type": "string", "minLength": 1},
    "source_digests": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "uniqueItems": true
    },
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_refs": {
      "type": "array",
      "items": {"$ref": "signature-ref.schema.json"}
    }
  }
}

