# Local placeholders only. The hermetic demo requires no secrets.
HSAI_DATABASE_URL=postgres://hsai:replace_me@127.0.0.1:5432/hsai
HSAI_BLOBSTORE_ENDPOINT=http://127.0.0.1:9000
HSAI_BLOBSTORE_BUCKET=hsai-evidence
HSAI_OPERATOR_AUTH_ISSUER=https://replace.invalid/
HSAI_OPERATOR_AUTH_AUDIENCE=hsai-operator
# Signer references identify an external signer; never place private key bytes here.
HSAI_ATTESTOR_SIGNER_REF=replace-with-kms-or-hsm-reference
