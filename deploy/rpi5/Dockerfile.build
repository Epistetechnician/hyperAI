# Cross-build the aarch64 `hyperai` binary for a Raspberry Pi 5 (64-bit OS).
#   docker buildx build --platform linux/arm64 -f deploy/rpi5/Dockerfile.build \
#     --output type=local,dest=dist/rpi5 .
# Result: dist/rpi5/hyperai   (copy to the Pi; see README.md)
# NOTE: not exercised in CI. Verify `file dist/rpi5/hyperai` reports ARM aarch64.
FROM rust:1.93.1-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends cmake clang \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cargo build --release --locked -p outcomes-cli --bin hyperai

FROM scratch AS artifact
COPY --from=build /src/target/release/hyperai /hyperai
